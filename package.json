{
  "name": "african-mandate",
  "version": "0.0.0-test-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.16.0",
    "pnpm": "11.23.0"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "format:check": "prettier --check package.json pnpm-workspace.yaml tsconfig.base.json tsconfig.json eslint.config.js toolchain.json .github/workflows/ci.yml apps packages scripts tests/unit tests/e2e tests/fixtures",
    "deps:check": "corepack pnpm peers check",
    "lint": "eslint apps packages scripts tests/unit",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "corepack pnpm run test:unit && corepack pnpm run test:determinism && corepack pnpm run test:fixture && corepack pnpm run test:boundaries",
    "test:unit": "vitest run tests/unit",
    "test:ui": "vitest run tests/unit/ui-shell.test.tsx",
    "test:map-docs": "vitest run tests/unit/map-documents.test.tsx",
    "test:decisions": "vitest run tests/unit/decision-workflow.test.ts",
    "test:editorial": "vitest run tests/unit/editorial-qa.test.ts tests/unit/narrative-fallback.test.ts",
    "test:data-acquisition": "vitest run tests/unit/production-data-acquisition.test.ts",
    "test:scenario-approval": "vitest run tests/unit/production-scenario.test.ts",
    "test:data-audit": "tsx scripts/verify-production-source-audit.ts",
    "test:editorial-lint": "tsx scripts/verify-editorial-conformance.ts",
    "test:editorial:e2e": "playwright test tests/e2e/editorial-conformance.spec.ts --config playwright.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:headless": "vitest run tests/unit/headless-acceptance.test.ts",
    "test:determinism": "node scripts/verify-determinism-vectors.mjs",
    "test:fixture": "node scripts/verify-fixture-build.mjs",
    "test:boundaries": "node scripts/verify-forbidden-import.mjs && node scripts/verify-forbidden-random.mjs",
    "schema:check": "node scripts/verify-governance-artifacts.mjs",
    "ci": "corepack pnpm run format:check && corepack pnpm run deps:check && corepack pnpm run lint && corepack pnpm run typecheck && corepack pnpm run test && corepack pnpm run test:editorial-lint && corepack pnpm run test:data-audit && corepack pnpm run schema:check"
  },
  "devDependencies": {
    "@african-mandate/application": "workspace:*",
    "@african-mandate/content": "workspace:*",
    "@african-mandate/data-pipeline": "workspace:*",
    "@african-mandate/domain": "workspace:*",
    "@african-mandate/headless": "workspace:*",
    "@african-mandate/narrative": "workspace:*",
    "@african-mandate/simulation": "workspace:*",
    "@african-mandate/tooling": "workspace:*",
    "@african-mandate/ui": "workspace:*",
    "@african-mandate/web": "workspace:*",
    "@eslint/js": "10.0.1",
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.1",
    "@types/geojson": "7946.0.16",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/node": "22.19.0",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
